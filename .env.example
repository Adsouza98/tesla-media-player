# Copy to .env and fill in. Never commit the real file.

# Required in practice. If empty, the container writes a random password
# to /config/generated-password on first start.
APP_PASSWORD=change-me

# Plex. The Tesla only talks to Vela; Vela talks to Plex.
PLEX_URL=http://192.168.1.42:32400
PLEX_TOKEN=

# 480, 720, 1080, or max
DEFAULT_QUALITY=1080

# Optional public HTTPS via the compose "https" profile (Caddy).
# On the homelab, prefer the existing Nginx Proxy Manager instead.
VELA_DOMAIN=vela.example.com
CADDY_EMAIL=
