# Copy to .env and fill in. Never commit the real file.

# Owner cabin password. Also works when the username is left blank.
# If empty, the container writes a random password to /config/generated-password.
APP_PASSWORD=change-me

# Two seats only. These fill empty fields on first start; Settings wins after that.
OWNER_NAME=Andre
OWNER_USERNAME=andre
# Email on your Plex account, and the Google account if you turn Google on.
OWNER_EMAIL=
OWNER_PLEX_USERNAME=
# Grok test seat. Leave TEST_PASSWORD empty to generate one in /config/test-user.
TEST_USERNAME=grok
TEST_PASSWORD=
TEST_EMAIL=
TEST_PLEX_USERNAME=

# Optional. The Tesla browser usually blocks Google's own login page.
# Create an OAuth web client and register the redirect printed in Settings:
# https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public https origin behind Nginx Proxy Manager. Recommended once Google is on.
PUBLIC_URL=

# Plex. The Tesla only talks to Vela; Vela talks to Plex.
PLEX_URL=http://192.168.1.42:32400
PLEX_TOKEN=

# 480, 720, 1080, or max
DEFAULT_QUALITY=1080

# Optional public HTTPS via the compose "https" profile (Caddy).
# On the homelab, prefer the existing Nginx Proxy Manager instead.
VELA_DOMAIN=vela.example.com
CADDY_EMAIL=
